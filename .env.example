# Copy to .env for local `netlify dev` use. In production, set these as
# Netlify environment variables instead (see README.md).

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
GOOGLE_PORTRAITS_FOLDER_ID=

# Transcription (netlify/functions/transcribe-stories.js) -- reuses
# GOOGLE_OAUTH_CLIENT_ID/SECRET above (same OAuth client, no separate
# service account) but has its OWN refresh token below, deliberately
# separate from GOOGLE_OAUTH_REFRESH_TOKEN. See README.md for why.
GOOGLE_TRANSCRIPTS_FOLDER_ID=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_VERTEX_MODEL=gemini-2.5-flash
GOOGLE_VERTEX_REFRESH_TOKEN=
