# Copy to .env for local `netlify dev` use. In production, set these as
# Netlify environment variables instead (see README.md).

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=

# Transcription (netlify/functions/transcribe-stories.js) -- a separate
# service account, not the OAuth credentials above. See README.md.
GOOGLE_TRANSCRIPTS_FOLDER_ID=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_VERTEX_SERVICE_ACCOUNT_JSON=
GOOGLE_VERTEX_MODEL=gemini-2.5-flash
